Screen {
    layers: normal floating;
}

Column:focus-within {
    border: double green;
}

Column {
    align-horizontal: center;
    max-width: 26;
    border: solid gray;

    Static {
        background: blue;
        text-align: center;
    }

    Card {
        text-align: left;
        background: #3f3f3f;
        margin: 1;
        border: solid;

    }

    Card:focus {
        border: double;
        background: #5f5f5f;
    }
}


CardBack {
    align: center middle;

    #cardback-scroll {
        border: solid blue;
        width: 80;

        #cardback-grid {
            grid-size: 2 2;
            grid-columns: 60 20;

            .description {
                TextArea {
                    max-height: 30;
                }
            }

            #cardback-info { 

                .description {
                    border: double;
                }

                #tag-list {
                    border: solid yellow;
                    align-vertical: middle;

                    Label.tag {
                        background: green;
                        color: white;
                        margin-left: 1;
                    }
                }

                #comments {
                    Static.comment {
                        border-top: solid;
                        margin-top: 1;
                        padding-top: 1;
                        padding-bottom: 1;
                        border-left: solid;
                        border-right: solid;
                    }
                }
                TextArea {
                    min-height: 5;
                    margin-top: 1;
                    margin-bottom: 1;
                }
            }
            #side-controls {
                Label {
                    margin-top: 1;
                }
            }
        }
    }

}


Shibboleth Horizontal {
    height: 3;
    align-horizontal: right;
}

Card.moving {
    layer: floating;
    height: 4;
    width: 26;
    background: blue;
    offset: 3 4;
    border: thick white;
}
