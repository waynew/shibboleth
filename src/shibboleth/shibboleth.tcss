Screen {
    layers: normal floating;
}

Column:focus-within {
    border: double green;
}

Column {
    align-horizontal: center;
    max-width: 26;
    border: solid gray;

    Static {
        background: blue;
        text-align: center;
    }

    Card {
        text-align: left;
        background: #3f3f3f;
        margin: 1;
        border: solid;

    }

    Card:focus {
        border: double;
        background: #5f5f5f;
    }
}

CardBack {
    align: center middle;


    #cardback-scroll {
        border: solid blue;
        #cardback-info { 
            border: solid;

            Static.description {
                border: double;
            }

            #comments {

                Static.comment {
                    border: solid;
                }
            }
            TextArea {
                min-height: 5;
                margin-top: 1;
                margin-bottom: 1;
            }

        }
